  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared engine action; labels change with the current operation.",
      "html": "<button class=\"ds-button\">Run factory</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid var(--accent);border-radius:.5rem;background:var(--accent);color:var(--hraness-palette-primary-foreground);padding:10px 15px;font:14px/1.65 var(--body);cursor:pointer;background-image:linear-gradient(to bottom,var(--hraness-material-edge),transparent 2px)}.ds-button:hover:not(:disabled){background:color-mix(in oklch,var(--accent) 92%,var(--ink));color:var(--hraness-palette-primary-foreground)}.ds-button:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-button:disabled{opacity:.5;cursor:default;background-image:none}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Save, cancel, and secondary world actions.",
      "html": "<button class=\"ds-button ds-secondary\">Save to file</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid var(--accent);border-radius:.5rem;background:var(--accent);color:var(--hraness-palette-primary-foreground);padding:10px 15px;font:14px/1.65 var(--body);cursor:pointer;background-image:linear-gradient(to bottom,var(--hraness-material-edge),transparent 2px)}.ds-button:hover:not(:disabled){background:color-mix(in oklch,var(--accent) 92%,var(--ink));color:var(--hraness-palette-primary-foreground)}.ds-button:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-button:disabled{opacity:.5;cursor:default;background-image:none}.ds-secondary{background:transparent;color:var(--accent)}.ds-secondary:hover:not(:disabled){background:var(--wash);color:var(--accent)}"
    },
    {
      "name": "Coordinate field",
      "kind": "input",
      "refersTo": "coordinate-field",
      "description": "Precise alternative to choosing a world tile by pointer.",
      "html": "<label class=\"ds-coordinate\">X<input type=\"number\" value=\"8\" min=\"0\" max=\"31\" aria-label=\"Site X\"></label>",
      "css": ".ds-coordinate{display:grid;gap:5px;color:var(--muted);font:12px/1.65 var(--body)}.ds-coordinate input{width:70px;box-sizing:border-box;padding:10px;min-height:42px;border:1px solid var(--control-border);background:var(--paper);color:var(--ink);border-radius:6px;font:14px var(--body)}.ds-coordinate input:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Site navigation",
      "kind": "nav",
      "description": "Shared text navigation; appearance control is owned by the design-kit provider.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/play\">Living world</a><a href=\"/docs\">Field guide</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:29px;font:14px/1.65 var(--body)}.ds-nav a{padding:12px 0;color:var(--ink);text-decoration:none}.ds-nav a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:.22em}.ds-nav a:focus-visible{outline:2px solid var(--focus);outline-offset:5px}"
    },
    {
      "name": "Selected facility row",
      "kind": "button",
      "refersTo": "selected-facility",
      "description": "The text and state portion of a machine row; the live game also displays its atlas sprite.",
      "html": "<button class=\"ds-facility\" aria-pressed=\"true\"><strong>Workshop</strong><span>Waiting for material</span></button>",
      "css": ".ds-facility{display:grid;gap:3px;text-align:left;min-height:58px;width:100%;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--hraness-material-warm-plane);color:var(--ink);font:13px/1.4 var(--body);cursor:pointer}.ds-facility strong{font-weight:600}.ds-facility span{color:var(--muted);font-size:11px}.ds-facility:hover{background:var(--wash)}.ds-facility:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Camera action",
      "kind": "button",
      "refersTo": "camera-button",
