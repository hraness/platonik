{
  "name": "platonik",
  "version": "0.1.0",
  "private": true,
  "description": "The Platonik game concept and documentation website.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check:content": "bun scripts/check-content.ts",
    "test:lab": "bun test lib/observatory",
    "test:site": "bun test lib/site-footer.test.ts",
    "check:theme": "node vendor/hraness-marketing/check.mjs && node vendor/hraness-lantern/check.mjs",
    "check:web": "bun run check:theme && bun run check:content && bun run test:lab && bun run test:site && bun run typecheck && bun run build",
    "check:rust": "bun scripts/check-rust.ts",
    "bridge:record": "bun scripts/record-bridge.ts --write",
    "challenges:record": "bun scripts/record-challenges.ts --write",
    "season:record": "bun scripts/record-season.ts season-0003 --write",
    "check": "bun run check:rust && bun run check:web"
  },
  "dependencies": {
    "@fontsource/newsreader": "5.3.0",
    "@hraness/design-kit": "github:hraness/design-kit#v0.8.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.13.0",
    "@hraness/suite-accounts": "github:hraness/suite-accounts#v0.9.10",
    "@hraness/ui": "github:hraness/ui#v0.5.13",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
