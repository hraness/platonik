{
  "id": "right-memory",
  "courier": {
    "rules": [
      {
        "when": [
          {
            "kind": "at_source",
            "value": true
          },
          {
            "kind": "carrying",
            "value": false
          }
        ],
        "action": {
          "kind": "pickup"
        },
        "remember": null
      },
      {
        "when": [
          {
            "kind": "at_receiver",
            "value": true
          },
          {
            "kind": "carrying",
            "value": true
          }
        ],
        "action": {
          "kind": "drop"
        },
        "remember": null
      },
      {
        "when": [
          {
            "kind": "blocked",
            "direction": "right",
            "value": false
          }
        ],
        "action": {
          "kind": "move",
          "direction": "right"
        },
        "remember": null
      },
      {
        "when": [
          {
            "kind": "blocked",
            "direction": "forward",
            "value": false
          }
        ],
        "action": {
          "kind": "move",
          "direction": "forward"
        },
        "remember": null
      },
      {
        "when": [],
        "action": {
          "kind": "move",
          "direction": "left"
        },
        "remember": null
      }
    ]
  },
  "controller": {
    "rules": [
      {
        "when": [
          {
            "kind": "has_message",
            "port": 0,
            "value": true
          }
        ],
        "action": {
          "kind": "take_message",
          "port": 0,
          "slot": 0
        },
        "remember": null
      },
      {
        "when": [],
        "action": {
          "kind": "route",
          "valve": 30,
          "bit": {
            "kind": "memory",
            "slot": 0
          }
        },
        "remember": null
      }
    ]
  }
}
